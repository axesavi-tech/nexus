# ---- Supabase (database + auth) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required for billing, checkout, webhooks and account deletion. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# ---- AI ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT=200

# ---- Payments: Cashfree (individuals can sign up with PAN + Aadhaar + bank account) ----
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production
CASHFREE_ENV=sandbox
# Public site URL used for payment return/notify links, e.g. https://nexus.yourdomain.com
APP_URL=

# ---- Billing economics (all optional; defaults shown) ----
# Credits per request = ceil(PRICING_MARGIN × cost ÷ (1 − COST_GATEWAY_FEE)), sold at ≥ ₹1/credit.
PRICING_MARGIN=3
COST_USD_INR=100
COST_INFRA_MONTHLY_INR=4500
COST_EXPECTED_REQUESTS_PER_MONTH=3000
COST_GATEWAY_FEE=0.023
# Comma-separated emails that are never charged (e.g. your own)
BILLING_EXEMPT_EMAILS=

# ---- Legal identity shown in policies and footer ----
NEXT_PUBLIC_LEGAL_NAME=Abhijit (sole proprietor), trading as NEXUS
NEXT_PUBLIC_LEGAL_ADDRESS=Pune, Maharashtra, India
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_GRIEVANCE_OFFICER=Abhijit
